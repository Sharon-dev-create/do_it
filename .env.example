# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# x402 / Circle Nanopayments
# Run `npm run generate-wallets` to auto-generate both seller and buyer wallets
SELLER_ADDRESS=0xYourSellerAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey

# Optional dedicated server-only signer. If omitted, SELLER_PRIVATE_KEY is accepted only
# when it derives to the deployed V2 verifier address 0x41aa5227695B8c6c5FfAD3bF3A9aAF0626921d0E.
DOIT_VERIFIER_PRIVATE_KEY=0xYourVerifierPrivateKey
# Comma-separated worker wallets allowed to use this V2 testnet prototype. Required for V2 submissions.
DOIT_V2_TEST_WORKERS=0xYourTestWorkerAddress
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Buyer wallet (for the payment agent)
BUYER_ADDRESS=0xYourBuyerAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey

# LangChain deep agent (OpenAI) — optional
# If omitted, the agent runs in mock mode with scripted tool calls.
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000


