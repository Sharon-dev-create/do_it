# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# Testnet RPCs (browser and server must remain on the same environment)
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_VERIFIER_ADDRESS=0x41aa5227695B8c6c5FfAD3bF3A9aAF0626921d0E
ARC_TESTNET_VERIFIER_ADDRESS=0x41aa5227695B8c6c5FfAD3bF3A9aAF0626921d0E
DOIT_V2_TEST_WORKERS=0xYourTestWorkerAddress

# Mainnet settings. Use only after an audited escrow deployment and release approval.
# ARC_NETWORK=mainnet
# NEXT_PUBLIC_ARC_NETWORK=mainnet
# Required for Mainnet. Use independently selected providers only after verifying chain ID 5042.
# NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_ARC_MAINNET_ESCROW_ADDRESS=0xYourVerifiedMainnetEscrowAddress
# ARC_MAINNET_ESCROW_ADDRESS=0xYourVerifiedMainnetEscrowAddress
# NEXT_PUBLIC_ARC_MAINNET_ESCROW_CODE_HASH=0xYourAuditedRuntimeCodeHash
# ARC_MAINNET_ESCROW_CODE_HASH=0xYourAuditedRuntimeCodeHash
# NEXT_PUBLIC_ARC_MAINNET_VERIFIER_ADDRESS=0xYourMainnetVerifierAddress
# ARC_MAINNET_VERIFIER_ADDRESS=0xYourMainnetVerifierAddress
# ARC_MAINNET_DEPLOYMENT_BLOCK=YourVerifiedDeploymentBlock
# DOIT_MAINNET_VERIFIER_PRIVATE_KEY=0xMainnetVerifierPrivateKey
# DOIT_MAINNET_WORKERS=0xApprovedMainnetWorkerAddress

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Testnet-only Circle Gateway / x402 settings.
SELLER_ADDRESS=0xYourSellerAddress
SELLER_PRIVATE_KEY=0xYourSellerPrivateKey

# Optional dedicated testnet verifier signer. If omitted, the seller key is
# accepted only when it derives to ARC_TESTNET_VERIFIER_ADDRESS.
DOIT_VERIFIER_PRIVATE_KEY=0xYourVerifierPrivateKey

# Testnet-only buyer wallet for the payment agent. Never use this on mainnet.
BUYER_ADDRESS=0xYourBuyerAddress
BUYER_PRIVATE_KEY=0xYourBuyerPrivateKey

# LangChain deep agent (OpenAI) — optional
# If omitted, the agent runs in mock mode with scripted tool calls.
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
